{
  "AllowedOrigins": ["http://localhost:5173"],
  "ReverseProxy": {
    "Routes": {
      "identity": { "ClusterId": "identity", "Match": { "Path": "/api/auth/{**catch-all}" } },
      "catalog": { "ClusterId": "catalog", "Match": { "Path": "/api/catalog/{**catch-all}" } },
      "subscriptions": { "ClusterId": "subscriptions", "Match": { "Path": "/api/subscriptions/{**catch-all}" } }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://identity" } } },
      "catalog": { "Destinations": { "d1": { "Address": "http://catalog" } } },
      "subscriptions": { "Destinations": { "d1": { "Address": "http://subscriptions" } } }
    }
  }
}

